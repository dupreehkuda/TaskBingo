# Copy to .env on the Timeweb host and fill in real values.
# Do NOT commit the filled-in version.

# === Backend ==============================================================
GAME_SERVICE_ADDRESS=:8082

# Existing Timeweb DBaaS Postgres. Use the connection string from the
# Timeweb panel; sslmode=require is what their managed PG expects.
DATABASE_DSN=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# 32+ char random string used to sign JWTs. Rotate ⇒ logs everyone out.
SECRET=replace-me-with-a-long-random-string

# Used by setAuthCookie. Must match the public domain (no protocol, no port).
CURRENT_DOMAIN=taskbingo.com

# Comma-separated list of allowed WebSocket origins for /api/game/start.
ALLOWED_WS_ORIGINS=https://taskbingo.com

# === Frontend (baked into the Vite build at image build time) =============
# All three point at the public domain — nginx proxies /api and /ws back
# to the server container. Keeps the browser on a single origin.
VITE_API_URL=https://taskbingo.com
VITE_WS_URL=wss://taskbingo.com
VITE_WEB_URL=taskbingo.com
