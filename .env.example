GAME_SERVICE_ADDRESS=:8082

DATABASE_DSN=postgresql://user:pswd@taskbingo-postgres:5432/user-data
PSQL_DSN_SERVER=postgresql://user:pswd@localhost:5432/user-data

DB_HOST=taskbingo-postgres
DB_DRIVER=postgres
DB_USER=user
DB_PASSWORD=pswd
DB_NAME=user-data
DB_PORT=5432
# HOST_DB_PORT only matters for `make compose` — it's the port the host maps
# postgres to. Override (e.g. 5433) when 5432 is already taken locally.
HOST_DB_PORT=5432

SECRET=ohsecret

CURRENT_DOMAIN=localhost
ALLOWED_WS_ORIGINS=http://localhost:3000,https://taskbingo.com

# Frontend points at its own origin; Vite dev server proxies /api and /ws to
# the backend container at :8082. Keeps everything same-origin so Safari ITP
# and CORS preflight caches stay out of the way during local dev.
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
VITE_WEB_URL=localhost:3000
